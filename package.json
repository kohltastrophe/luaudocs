{
	"name": "luaudocs",
	"version": "0.1.0",
	"description": "Documentation generator for Luau.",
	"keywords": [
		"luau",
		"documentation",
		"documentation-generator",
		"docs",
		"roblox",
		"vitepress",
		"moonwave"
	],
	"author": "Kohl (https://github.com/kohltastrophe)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kohltastrophe/luaudocs.git"
	},
	"homepage": "https://luaudocs.kohl.gg",
	"bugs": "https://github.com/kohltastrophe/luaudocs/issues",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"bin": {
		"luaudocs": "dist/cli.js"
	},
	"exports": {
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"extractor",
		"!extractor/tests",
		"templates",
		"CHANGELOG.md"
	],
	"scripts": {
		"dev": "bun run src/cli.ts",
		"build": "tsup",
		"generate": "tsx scripts/generate.ts",
		"lute": "bun run scripts/lute.ts",
		"regen:docmodels": "bun run scripts/regen-docmodels.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:luau": "stylua --verify extractor examples",
		"format:luau:check": "stylua --check --verify extractor examples",
		"prepare": "npm run generate && tsup",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:lute": "bun run scripts/lute.ts run extractor/tests/run.luau"
	},
	"dependencies": {
		"picocolors": "^1.1.1",
		"picomatch": "^4.0.2",
		"smol-toml": "^1.3.1"
	},
	"devDependencies": {
		"@johnnymorganz/stylua-bin": "^2.5.2",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^22.10.0",
		"@types/picomatch": "^4.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"prettier": "^3.9.6",
		"shiki": "^4.4.3",
		"tsup": "^8.3.5",
		"tsx": "^4.23.12",
		"typescript": "^5.7.2",
		"vitepress": "2.0.0-alpha.19",
		"vitepress-plugin-group-icons": "^1.7.6",
		"vitest": "^3.0.0",
		"vue": "^3.5.13"
	}
}
