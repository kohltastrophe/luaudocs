--- The Roblox API dump as the extractor reads it, generated by `bun run
--- generate` (the prepare hook and CI run it) and never checked in.
---
--- Optional on purpose, which is the whole reason this module exists: a
--- checkout that never installed still runs on detection's convention signals
--- and the engine-blind half of what inference knows. Loading it once keeps
--- that contract in one place, along with the generated table's shape: a list
--- added to scripts/generate.ts is added to the type and to `LISTS` below, and
--- nowhere else. Luau derives neither from the other, so the two sit adjacent.

local hasLists, loaded = pcall(require, "./generated/engine")

type EngineLists = {
	yieldingMethods: { [string]: boolean },
	pluginMembers: { [string]: boolean },
	methodReturns: { [string]: string },
	datatypes: { [string]: boolean },
	enums: { [string]: boolean },
}

--- Every list the type above names. A file generated before one was added
--- loads fine and then fails on the first index of it, so an incomplete table
--- counts as no table at all: the absent-file fallbacks are what it needs.
local LISTS = { "yieldingMethods", "pluginMembers", "methodReturns", "datatypes", "enums" }

local function complete(lists: any): boolean
	if type(lists) ~= "table" then
		return false
	end
	for _, name in LISTS do
		if type(lists[name]) ~= "table" then
			return false
		end
	end
	return true
end

local engine: { lists: EngineLists? } = { lists = if hasLists and complete(loaded) then loaded else nil }

return engine
