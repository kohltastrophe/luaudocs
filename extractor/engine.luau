--- Loader for the Roblox API dump tables generated by `bun run generate`
--- (`extractor/generated/engine.luau`, which is gitignored and built by the
--- `prepare` hook and CI).
---
--- Kept optional so a fresh checkout where `bun run generate` has not run yet
--- still works using `detect`'s naming conventions and `infer`'s non-engine
--- rules. Any new list added in `scripts/generate.ts` must be added to both
--- `EngineLists` and `LISTS` below.

local hasLists, loaded = pcall(require, "./generated/engine")

type EngineLists = {
	yieldingMethods: { [string]: boolean },
	pluginMembers: { [string]: boolean },
	methodReturns: { [string]: string },
	datatypes: { [string]: boolean },
	enums: { [string]: boolean },
}

--- Required keys on `EngineLists`. If an older `generated/engine.luau` is
--- missing a newly added table, treat the module as absent rather than failing
--- on the first index of the missing key.
local LISTS = { "yieldingMethods", "pluginMembers", "methodReturns", "datatypes", "enums" }

local function complete(lists: any): boolean
	if type(lists) ~= "table" then
		return false
	end
	for _, name in LISTS do
		if type(lists[name]) ~= "table" then
			return false
		end
	end
	return true
end

local engine: { lists: EngineLists? } = { lists = if hasLists and complete(loaded) then loaded else nil }

return engine
